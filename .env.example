AI_PROVIDER=openai

AI_API_KEY=
# Optional alias if you already use OpenAI SDK naming.
OPENAI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60
AI_CREDIT_BLOCK_MINUTES=1440
AI_RATE_LIMIT_BLOCK_MINUTES=15

GEMINI_API_KEY=
# Optional alias supported by Gemini docs.
GOOGLE_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.6-flash

OBJECT_DETECTION_PROVIDER=fastapi
OBJECT_DETECTION_FASTAPI_URL=http://127.0.0.1:8000/predict
OBJECT_DETECTION_FASTAPI_HEALTH_URL=http://127.0.0.1:8000/health

# Use these when OBJECT_DETECTION_PROVIDER=roboflow.
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_CONFIDENCE=40
ROBOFLOW_OVERLAP=30
ROBOFLOW_CONNECT_TIMEOUT=20
ROBOFLOW_TIMEOUT=60
ROBOFLOW_FORCE_IPV4=1
