AI_PROVIDER=openai
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_API_KEY=
# Optional alias if you already use OpenAI SDK naming.
OPENAI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60
AI_CREDIT_BLOCK_MINUTES=1440
AI_RATE_LIMIT_BLOCK_MINUTES=15

GEMINI_API_KEY=
# Optional alias supported by Gemini docs.
GOOGLE_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.6-flash
